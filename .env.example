# Copy to .env. Never commit .env.
#
# RECOMMENDED: OpenRouter — one key reaches every model family the study needs
# (cheap #1 for the full grid, cheap #2 and a frontier model for reduced grids),
# so `model` stays an experimental variable instead of an integration project.
# Get a key at https://openrouter.ai/keys and top up ~$25; that covers the whole study.
OPENROUTER_API_KEY=

# Optional direct providers, if you prefer them over OpenRouter for a given model.
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Default model for development. Override per run with --model.
#
# Bake-off candidates (WP 0.6) — chosen for tool-calling reliability, then price.
# Deliberately three different model families, so a finding is not one lineage's quirk.
#   1. openrouter:z-ai/glm-4.7-flash      GLM family  — 98.8% tau2-bench, ~$0.05/$0.17
#   2. openrouter:deepseek/deepseek-v4-flash  DeepSeek — "value pick", ~$0.14/$0.28
#   3. openrouter:google/gemini-3.7-flash  Google      — strong cost/perf on tau2
# Frontier (reduced grid only):
#      openrouter:anthropic/claude-sonnet-5
# Free/local dev:
#      ollama:gemma4:e2b   (plumbing only — loops and skips evidence; not for real runs)
#
# Verify exact model ids and current prices on openrouter.ai/models before committing.
FAULTPROP_MODEL=ollama:gemma4:e2b
